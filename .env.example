# Docker-Instanz. Die Standardwerte laufen parallel zu einem offiziellen
# Container namens "restreamer" und binden die Webports nur an localhost.
RESTREAMER_PROJECT_NAME=restreamer-nkl
RESTREAMER_CONTAINER_NAME=vortex
RESTREAMER_IMAGE=ghcr.io/glatzkopf94/restreamer-nistkastenlivestream:0.3.0-dev26
RESTREAMER_BIND_ADDRESS=127.0.0.1
RESTREAMER_HTTP_PORT=9080
RESTREAMER_API_PORT=9181
RESTREAMER_CONFIG_VOLUME=restreamer-nkl-config
RESTREAMER_DATA_VOLUME=restreamer-nkl-data

# Abwaertskompatible globale Overlay-Quelle. Neue Installationen konfigurieren
# JSON-Quellen und Vorlagen direkt am jeweiligen Stream im Webinterface und
# lassen die folgenden OVERLAY_*-Werte leer.
OVERLAY_JSON_URL=

# Getrennte Quellen fuer Temperatur und Luftfeuchte. Diese beiden Angaben
# haben Vorrang vor OVERLAY_JSON_URL.
OVERLAY_TEMPERATURE_JSON_URL=
OVERLAY_HUMIDITY_JSON_URL=

# Optionaler gemeinsamer HTTP-Header, z. B. Authorization: Bearer ...
OVERLAY_HTTP_HEADER=

# Optional getrennte Header. Sie haben Vorrang vor OVERLAY_HTTP_HEADER.
OVERLAY_TEMPERATURE_HTTP_HEADER=
OVERLAY_HUMIDITY_HTTP_HEADER=

OVERLAY_INTERVAL_SECONDS=60

# jq-Ausdruecke fuer die jeweilige JSON-Antwort. Shelly Number.GetStatus
# liefert den Messwert normalerweise im Feld .value.
OVERLAY_TEMPERATURE_JQ=.value // .temperature // .current.temperature_2m
OVERLAY_HUMIDITY_JQ=.value // .humidity // .current.relative_humidity_2m

OVERLAY_TEMPERATURE_LABEL=Temp
OVERLAY_HUMIDITY_LABEL=F
OVERLAY_TEMPERATURE_DECIMALS=1
OVERLAY_HUMIDITY_DECIMALS=0

# Private, persistente Zeitrafferablage; kein oeffentliches DVR-Verzeichnis.
RESTREAMER_TIMELAPSE_VOLUME=restreamer-nkl-timelapse
NKL_TIMELAPSE_ENABLE=true
NKL_TIMELAPSE_QUOTA_BYTES=21474836480
NKL_TIMELAPSE_RESERVE_BYTES=2147483648
