@@ -37,6 +37,34 @@ use tokio_util::{
 
 const MTU: usize = 1350;
 const UDPDATA_HEADER_SIZE: usize = 20;
+const ACK_BITMAP_LIMIT: usize = MTU - 28;
+const REORDER_WINDOW: u32 = 8192;
+
+fn ack_bitmap(first_missing: u32, received: &BTreeMap<u32, Vec<u8>>) -> Vec<u8> {
+    let mut bits = Vec::new();
+    for (&id, _) in received.range(first_missing..) {
+        let offset = (id - first_missing) as usize;
+        if offset >= ACK_BITMAP_LIMIT {
+            // Indicate missing packets up to the end of the advertised window.
+            bits.resize(ACK_BITMAP_LIMIT, 0);
+            break;
+        }
+        bits.resize(offset + 1, 0);
+        bits[offset] = 1;
+    }
+    bits
+}
+
+#[test]
+fn uid_recovery_ack_window() {
+    let packets = [(12, vec![]), (14, vec![])].iter().cloned().collect();
+    assert_eq!(ack_bitmap(10, &packets), vec![0, 0, 1, 0, 1]);
+    assert!(ack_bitmap(15, &packets).is_empty());
+    let distant = [(11, vec![]), (u32::MAX, vec![])].iter().cloned().collect();
+    let bits = ack_bitmap(10, &distant);
+    assert_eq!(bits.len(), ACK_BITMAP_LIMIT);
+    assert_eq!(bits[1], 1);
+}
 
