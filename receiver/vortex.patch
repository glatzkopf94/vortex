     YieldNow, // Used to ensure we rest between polling packets so as to not starve the runtime
 }
 
+enum AckProfile {
+    Standard,
+    Fixed810,
+    Dynamic { since: Instant, bytes: u32, reported: u32 },
+}
+
+impl AckProfile {
+    fn dynamic(now: Instant) -> Self {
+        Self::Dynamic { since: now, bytes: 0, reported: 0 }
+    }
+
+    fn observe(&mut self, now: Instant, payload_bytes: u32) {
+        if let Self::Dynamic { since, bytes, reported } = self {
+            if now.duration_since(*since) >= Duration::from_secs(1) {
+                *reported = *bytes;
+                *bytes = 0;
+                *since = now;
+            }
+            *bytes = bytes.saturating_add(payload_bytes);
+        }
+    }
+
+    fn value(&self, standard: u32) -> u32 {
+        match self {
+            Self::Standard => standard,
+            Self::Fixed810 => 446_920,
+            Self::Dynamic { reported, .. } => *reported,
+        }
+    }
+}
+
+#[test]
+fn dynamic_ack_reports_payload_bytes_per_window() {
+    let start = Instant::now();
+    let mut profile = AckProfile::dynamic(start);
+    profile.observe(start, 1200);
+    profile.observe(start + Duration::from_millis(999), 300);
+    assert_eq!(profile.value(77), 0);
+    profile.observe(start + Duration::from_millis(1020), 250);
+    assert_eq!(profile.value(77), 1500);
+    profile.observe(start + Duration::from_millis(2020), 0);
+    assert_eq!(profile.value(77), 250);
+    profile.observe(start + Duration::from_millis(3020), 0);
+    assert_eq!(profile.value(77), 0);
+}
