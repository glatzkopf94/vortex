# Updating the release metadata on main triggers the reproducible release workflow.
# The publisher creates the tag through the Release API for each release.
RELEASE_VERSION=0.3.0-dev35
PRODUCT_VERSION=1.7-beta
PRODUCT_LABEL="Vortex 1.7 Beta"
GHCR_IMAGE=ghcr.io/glatzkopf94/restreamer-nistkastenlivestream

# Compatibility image used by dev22 updaters; identical Vortex alias is also published.
# dev35: channel-specific live overlay DVR window, default 5 minutes.
